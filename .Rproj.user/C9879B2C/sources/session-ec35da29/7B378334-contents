```

```{r}
data1
data1cleaned<-data1[c('Category','Year','% Attendance')]
data1cleaned
```

```{r}
ggplot(data1cleaned, aes(x = Year, y = data1$'% Attendance', fill = Category)) +
  geom_bar(stat = "identity", position = "dodge") +
  labs(
    #title = "Different Economic Groups' % Attendance from 2016-2021",
    x = "Year", y = "% Attendance") +
  scale_fill_manual(values = c("#ff8800", "#236290"))+
  coord_cartesian(ylim = c(85, 95)) +
  theme_classic()
#(axis.line = element_line(color = "black", size = 0.5))
```
```{r}
category1<-c("Poverty","Not Poverty")
povertydata <- data1cleaned %>% filter(Category=="Poverty")
pmean<- mean(povertydata$`% Attendance`)
psd<- sd(povertydata$`% Attendance`)
notpovertydata <- data1cleaned %>% filter(Category=="Not Poverty")
npmean<- mean(notpovertydata$`% Attendance`)
npsd<-sd(notpovertydata$`% Attendance`)
Mean<-c(pmean,npmean)
sd<-c(psd,npsd)
```

```{r}
t.test(povertydata$`% Attendance`,notpovertydata$`% Attendance`)
```

```{r}
ggplot(data.frame(category1, Mean, sd), aes(x = category1, y = Mean, fill = category1)) + 
  geom_bar(stat = "identity", position = "dodge") + # Use position = "dodge" for grouped bars if needed
  geom_errorbar(aes(ymin = Mean - sd, ymax = Mean + sd), width = 0.2) + # Error bars
  ylab("Attendance Percentage") + 
  xlab("Category") +
  coord_cartesian(ylim = c(85, 95))+
  theme_minimal()
```

```{r}
model <- lm(`% Attendance` ~ Category, data = data1)
summary(model)
```
